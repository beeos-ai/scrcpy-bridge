############################
# Stage 1 — take the prebuilt musl binary from the build context
############################
#
# The release workflow builds static musl binaries in the `binaries`
# matrix job and stages them into the Docker context as:
#
#   dist/x86_64-unknown-linux-musl/scrcpy-bridge
#   dist/aarch64-unknown-linux-musl/scrcpy-bridge
#
# We deliberately do NOT curl GitHub Releases from inside the image
# build: multi-arch buildx (esp. the qemu arm64 path) hits flaky
# release-assets.githubusercontent.com downloads (curl exit 56) and
# races the softprops upload. Artifact → COPY is same-runner local
# IO and is what every reliable multi-arch release pipeline does.
#
# Buildx fans this stage out across `linux/amd64,linux/arm64`, so each
# platform copies its own binary without any cross-compilation tooling.
#
FROM --platform=$BUILDPLATFORM alpine:3.20 AS fetcher

ARG TARGETARCH

RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64)  ARCH="x86_64-unknown-linux-musl" ;; \
      arm64)  ARCH="aarch64-unknown-linux-musl" ;; \
      *)      echo "unsupported arch: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    echo "TARGETARCH=${TARGETARCH} ARCH=${ARCH}"

# Build-context paths produced by the release workflow's "Stage musl
# binaries for docker context" step.
COPY dist/ /dist/

RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64)  ARCH="x86_64-unknown-linux-musl" ;; \
      arm64)  ARCH="aarch64-unknown-linux-musl" ;; \
      *)      echo "unsupported arch: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    test -x "/dist/${ARCH}/scrcpy-bridge" \
      || (echo "missing /dist/${ARCH}/scrcpy-bridge — release workflow must stage musl artifacts" >&2; ls -laR /dist; exit 1); \
    install -m 0755 "/dist/${ARCH}/scrcpy-bridge" /scrcpy-bridge; \
    /scrcpy-bridge --version 2>/dev/null || true

############################
# Stage 2 — alpine runtime
############################
#
# scrcpy-bridge shells out to `adb`. An earlier revision used
# distroless/static and hand-copied Alpine's adb plus ld-musl + libusb —
# but Alpine's android-tools adb is dynamically linked against a dozen
# more libs (libprotobuf, libz, absl, brotli, lz4, zstd, libstdc++,
# libgcc_s, …), so adb died with exit 127 at runtime and WebRTC offers
# could never be answered. Use Alpine directly and let apk resolve the
# full dependency closure; the image stays ~15 MB.
#
FROM alpine:3.20

ARG VERSION=dev
LABEL org.opencontainers.image.source="https://github.com/beeos-ai/scrcpy-bridge" \
      org.opencontainers.image.title="scrcpy-bridge" \
      org.opencontainers.image.description="WebRTC bridge for scrcpy H.264 streams" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="MIT"

RUN apk add --no-cache android-tools ca-certificates \
    && adduser -D -u 65532 nonroot

COPY --from=fetcher /scrcpy-bridge /usr/local/bin/scrcpy-bridge

ENV ADB_HOST=127.0.0.1 \
    ADB_PORT=5037 \
    METRICS_PORT=9091 \
    LOG_FORMAT=json \
    HOME=/home/nonroot

EXPOSE 9091

USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/scrcpy-bridge"]
